{
  "name": "multi-browser-account-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent browser workspaces for Windows",
  "author": "Multi-Browser Account Manager",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/*.browser.ts",
    "worker": "node src/server.js",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "browsers:win": "node scripts/windows-browser.mjs",
    "package:win:bundled": "npm run browsers:win && npm run build && node scripts/package-bundled.cjs",
    "test:startup": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.8.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "resedit": "^3.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.multibrowser.manager",
    "productName": "Multi Browser Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MultiBrowserManager-${version}-Setup-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "script": "build/installer.nsi",
      "installerLanguages": [
        "en_US"
      ]
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "MultiBrowserManager-${version}-Portable-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
