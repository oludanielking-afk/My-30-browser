# Review official current allowances and all existing account usage FIRST.
# Values below are candidate settings, NOT proof of free eligibility.
FREE_TIER_VERIFIED=no
ALLOWANCE_CHECKED_ON=
# Remaining for this deployment = total current allowance minus OTHER resources.
# Do not subtract this selected VM/volume twice after it has been created.
REMAINING_FREE_OCPUS=
REMAINING_FREE_RAM_GB=
REMAINING_FREE_STORAGE_GB=
SELECTED_INSTANCE_OCPUS=4
SELECTED_INSTANCE_RAM_GB=24
SELECTED_STORAGE_GB=50
CPU_LIMIT=3
MEMORY_LIMIT=18g
MAX_ACTIVE=3
MEMORY_RESERVE_MB=1536
BROWSER_BUDGET_MB=1024
DISK_RESERVE_MB=2048
CPU_CEILING_PERCENT=85
# SSH tunnel uses HTTP over the encrypted SSH connection. Set 1 only behind HTTPS.
COOKIE_SECURE=0
